# Discord
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_discord_server_id_here

# Database (PostgreSQL)
# For local: postgresql://user:password@localhost:5432/ryze_bot
# For Railway/Render: provided automatically
DATABASE_URL=postgresql://ryze_user:password@localhost:5432/ryze_bot

# Google Calendar OAuth2
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REFRESH_TOKEN=your_google_oauth_refresh_token
GOOGLE_PROJECT_ID=your_google_project_id

# App Settings
DEFAULT_TIMEZONE=Australia/Sydney
LOG_LEVEL=INFO

# Optional tuning
CALENDAR_SYNC_INTERVAL=10
CALENDAR_SYNC_DAYS_AHEAD=30

# Admin portal REST API
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_API_KEY=change_me_generate_a_secure_random_key
# Comma-separated allowed CORS origins (include your production domain)
DASHBOARD_CORS_ORIGINS=http://localhost:5173,https://ryzeeducation.com.au

# JWT auth (portal user sessions)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_generate_a_jwt_secret
JWT_EXPIRE_MINUTES=1440

# Discord OAuth2 (student/tutor/admin login via "Login with Discord")
# Create an OAuth2 application at https://discord.com/developers/applications
# Add redirect URI: http://localhost:5173/auth/discord/callback
DISCORD_CLIENT_ID=your_discord_oauth_app_client_id
DISCORD_CLIENT_SECRET=your_discord_oauth_app_client_secret
DISCORD_REDIRECT_URI=http://localhost:5173/auth/discord/callback

# Portal base URL (used in parent invite emails)
PORTAL_BASE_URL=http://localhost:5173

# Optional: Discord channel ID for member-join admin notifications
ADMIN_NOTIFICATION_CHANNEL_ID=
