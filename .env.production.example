# ─────────────────────────────────────────────────────────────────────────────
# Ryze Education — PRODUCTION .env
# Copy this to .env on your OCI server and fill in every value.
#
# Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (used by docker-compose to create the DB + by the app) ────────
DB_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD

# ── Discord Bot ───────────────────────────────────────────────────────────────
DISCORD_TOKEN=YOUR_BOT_TOKEN
DISCORD_GUILD_ID=1490369427961675966

# ── Database (docker-compose overrides this — keep in sync with DB_PASSWORD) ──
DATABASE_URL=postgresql+asyncpg://ryze_user:CHANGE_ME_STRONG_RANDOM_PASSWORD@db:5432/ryze_bot

# ── Google Calendar OAuth2 ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REFRESH_TOKEN=YOUR_GOOGLE_REFRESH_TOKEN
GOOGLE_PROJECT_ID=ryze-education-discord-bot

# ── App Settings ──────────────────────────────────────────────────────────────
DEFAULT_TIMEZONE=Australia/Sydney
LOG_LEVEL=INFO

# ── Calendar Sync ─────────────────────────────────────────────────────────────
CALENDAR_SYNC_INTERVAL=10
CALENDAR_SYNC_DAYS_AHEAD=30

# ── Dashboard REST API ────────────────────────────────────────────────────────
DASHBOARD_API_KEY=GENERATE_RANDOM_64_HEX
DASHBOARD_CORS_ORIGINS=https://ryzeeducation.com.au,https://www.ryzeeducation.com.au

# ── JWT portal sessions ───────────────────────────────────────────────────────
JWT_SECRET_KEY=GENERATE_RANDOM_64_HEX
JWT_EXPIRE_MINUTES=1440

# ── Discord OAuth2 (portal login) ─────────────────────────────────────────────
DISCORD_CLIENT_ID=1504804833079857183
DISCORD_CLIENT_SECRET=WgbMLWd1TH3HzE1KqecnSBvBj-ngjv7f
DISCORD_REDIRECT_URI=https://ryzeeducation.com.au/auth/discord/callback

# ── Parent invite links ───────────────────────────────────────────────────────
PORTAL_BASE_URL=https://ryzeeducation.com.au
